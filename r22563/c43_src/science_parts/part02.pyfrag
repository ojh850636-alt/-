    import torch
    sys.path.insert(0,str(Path(__file__).resolve().parent))
    from c43_verifier import exact_or_token_equiv,semantic_equiv,syntax_ok
    out=[]
    with torch.inference_mode():
      for s in range(0,len(rows),batch):
        chunk=rows[s:s+batch]; prompts=[x['prompt_primary'] for x in chunk]
