        with torch.inference_mode(): logits=model(**enc).logits.float(); lp=torch.log_softmax(logits,dim=-1)
        for i in range(len(chunk)):
            plen=int(penc['attention_mask'][i].sum()); flen=int(enc['attention_mask'][i].sum())
            # target tokens are positions plen..flen-1, predicted by logits plen-1..flen-2
            toks=enc['input_ids'][i,plen:flen]; pred=lp[i,plen-1:flen-1]
            vals.append(float(pred.gather(1,toks.unsqueeze(1)).mean().item()))
    return vals

def extract_json(text):
    i=text.find('{')
    if i<0:return None
    depth=0; ins=False; esc=False
    for j in range(i,len(text)):
        ch=text[j]
        if ins:
            if esc: esc=False
            elif ch=='\\': esc=True
            elif ch=='"': ins=False
        else:
            if ch=='"': ins=True
            elif ch=='{': depth+=1
            elif ch=='}':
                depth-=1
                if depth==0:
                    try:return json.loads(text[i:j+1])
                    except:return None
    return None

def generate_rows(model,tok,rows,batch=1,max_new=80):
    out=[]
    for s in range(0,len(rows),batch):
        chunk=rows[s:s+batch]; enc=tok([r['prompt'] for r in chunk],return_tensors='pt',padding=True,add_special_tokens=False)
        plen=enc['input_ids'].shape[1]
        import torch
        with torch.inference_mode(): gen=model.generate(**enc,max_new_tokens=max_new,do_sample=False,use_cache=True,pad_token_id=tok.pad_token_id,eos_token_id=tok.eos_token_id)
        for i,r in enumerate(chunk):
            txt=tok.decode(gen[i,plen:],skip_special_tokens=True); obj=extract_json(txt)
            move=None
            if isinstance(obj,dict) and isinstance(obj.get('from'),str) and isinstance(obj.get('to'),str): move=(obj['from']+obj['to']).lower()
            out.append({'case_id':r['case_id'],'prediction_sha256':hashlib.sha256(txt.encode()).hexdigest(),'prediction_length':len(txt),'json_ok':isinstance(obj,dict),'move_uci':move,'has_explanation':bool(obj.get('explanation')) if isinstance(obj,dict) else False,'has_taunt':bool(obj.get('taunt')) if isinstance(obj,dict) else False})
    return out

def evaluate_generation(items, rows_by_id, engine_path):
    import chess, chess.engine
    eng=chess.engine.SimpleEngine.popen_uci(engine_path)
    metrics=[]
    try:
        for it in items:
            r=rows_by_id[it['case_id']]
            rec=dict(it); rec.update({'legal':False,'top1':False,'top3':False,'cp_loss':None,'action_like':bool(it['move_uci'])})
            if r['negative']:
                metrics.append(rec); continue
            b=chess.Board(r['fen']); mv=None
            try: mv=chess.Move.from_uci(it['move_uci']) if it['move_uci'] else None
            except: mv=None
            if mv in b.legal_moves:
                rec['legal']=True; rec['top1']=mv.uci()==r['top_moves'][0]['uci']; rec['top3']=mv.uci() in {x['uci'] for x in r['top_moves']}
                if rec['top3']:
                    scores={x['uci']:x['score_cp'] for x in r['top_moves']}; rec['cp_loss']=max(0,scores[r['top_moves'][0]['uci']]-scores[mv.uci()])
                else:
                    info=eng.analyse(b,chess.engine.Limit(nodes=6000),root_moves=[mv])
                    s=info['score'].pov(b.turn).score(mate_score=100000); s=int(s if s is not None else -100000)
                    rec['cp_loss']=max(0,r['top_moves'][0]['score_cp']-s)
            metrics.append(rec)
    finally: eng.quit()
    return metrics

