from __future__ import annotations
import argparse, hashlib, json, math, random, re, statistics
from collections import defaultdict
from pathlib import Path
SEED=22564
ADAPTER_SHA='ca0710c04480627b50bb1350bd32fdf5545a95c17ecab38eab3cd6f92c24c0d7'
BASE_SHA='6e6001da2106d4757498752a021df6c2bdc332c650aae4bae6b0c004dcf14933'
SPECIALS=['<|json|>','</|json|>']

def sha(p):
    h=hashlib.sha256()
    with open(p,'rb') as f:
        for b in iter(lambda:f.read(1<<20),b''): h.update(b)
    return h.hexdigest()
def mean(xs): return sum(xs)/len(xs) if xs else 0.0
def median(xs): return statistics.median(xs) if xs else None

def bootstrap_ci(vals,n=1600,seed=SEED):
    if not vals:return [0.0,0.0]
    r=random.Random(seed); N=len(vals); arr=[]
    for _ in range(n): arr.append(mean([vals[r.randrange(N)] for _ in range(N)]))
    arr.sort(); return [arr[int(.025*(n-1))],arr[int(.975*(n-1))]]

def load_rows(p): return [json.loads(x) for x in Path(p).read_text().splitlines() if x.strip()]

def static_forensics(path):
    from safetensors import safe_open
    out={'schema':'LAA_R22564_C44_STATIC_V1','adapter_sha256':sha(path)}; assert out['adapter_sha256']==ADAPTER_SHA
    stats={'lora_A':0,'lora_B':0,'embedding_like':0,'lm_head_like':0,'other':0}; elems=defaultdict(int); bytes_est=defaultdict(int); shapes={}; dtypes={}; zero_b=0; nonfinite=0; energy_proj=defaultdict(float); energy_layer=defaultdict(float)
    with safe_open(str(path),framework='pt',device='cpu') as f:
        for k in f.keys():
            sl=f.get_slice(k); shape=list(sl.get_shape()); n=math.prod(shape); shapes[k]=shape
            # dtype string from tensor; only load full LoRA tensors, not huge embeddings
            if '.lora_A.' in k or k.endswith('.lora_A.weight'): cat='lora_A'
            elif '.lora_B.' in k or k.endswith('.lora_B.weight'): cat='lora_B'
            elif 'embed_tokens' in k: cat='embedding_like'
            elif 'lm_head' in k: cat='lm_head_like'
            else: cat='other'
            stats[cat]+=1; elems[cat]+=n
            if cat in {'lora_A','lora_B'}:
                t=f.get_tensor(k); dtypes[k]=str(t.dtype); bytes_est[cat]+=n*t.element_size(); nonfinite+=int((~t.isfinite()).any().item())
                if cat=='lora_B': zero_b+=int(float(t.abs().max().item())==0.0)
                e=float((t.float()*t.float()).sum().item())
                proj=next((p for p in ['q_proj','k_proj','v_proj','o_proj','gate_proj'] if p in k),'other')
                energy_proj[proj]+=e
                m=re.search(r'layers\.(\d+)',k); energy_layer[m.group(1) if m else 'na']+=e
            else:
                # infer dtype bytes conservatively from safetensors slice repr is unavailable; load only shape, byte totals later by file conservation
                bytes_est[cat]=None
    total_elems=sum(elems.values())
