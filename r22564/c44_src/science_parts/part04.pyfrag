    pos=[x for x in metrics if x['case_id'] and x['cp_loss'] is not None or x.get('legal')]
    # include all nonnegative rows by checking keys in caller subsets; negatives are represented by cp_loss None + action_like
    legal=[x for x in metrics if x.get('legal')]
    return {'n':len(metrics),'json_rate':mean([x['json_ok'] for x in metrics]),'legal_rate':mean([x['legal'] for x in metrics]),'top1_rate':mean([x['top1'] for x in metrics]),'top3_rate':mean([x['top3'] for x in metrics]),'median_cp_loss_legal':median([x['cp_loss'] for x in legal if x['cp_loss'] is not None]),'mean_cp_loss_legal':mean([x['cp_loss'] for x in legal if x['cp_loss'] is not None]) if legal else None,'explanation_nonempty_rate':mean([x['has_explanation'] for x in metrics]),'taunt_nonempty_rate':mean([x['has_taunt'] for x in metrics])}

def self_test():
    from transformers import LlamaConfig,LlamaForCausalLM
    from peft import LoraConfig,get_peft_model
    cfg=LlamaConfig(vocab_size=128,hidden_size=64,intermediate_size=128,num_hidden_layers=3,num_attention_heads=4,num_key_value_heads=2,max_position_embeddings=64)
    m=get_peft_model(LlamaForCausalLM(cfg),LoraConfig(r=4,lora_alpha=8,target_modules=['q_proj','k_proj','v_proj','o_proj','gate_proj'],task_type='CAUSAL_LM'))
    base_aux={'embed':m.get_input_embeddings().weight.detach().cpu().clone(),'head':m.get_output_embeddings().weight.detach().cpu().clone()}; adapt_aux={'embed':base_aux['embed'].clone(),'head':base_aux['head'].clone()}
    c=Controller(m,base_aux,adapt_aux); c.set_condition('BASE'); assert all(abs(x.scaling[adapter_key(x)])<1e-12 for _,x in c.loras); c.set_condition('AUX_ONLY'); c.set_condition('LORA_ONLY'); c.set_condition('FULL'); c.random_sign(); c.restore_scale(); c.shuffle_B(); c.restore_B(); c.ablate_group('early:attn',3); c.group_only('late:mlp',3)
    print(json.dumps({'self_test':'PASS','lora_modules':len(c.loras)}))

def run(a):
    base=Path(a.work)/'base'; adapter=Path(a.work)/'adapter'; out=Path(a.out); out.mkdir(parents=True,exist_ok=True)
    assert sha(base/'model.safetensors')==BASE_SHA; assert sha(adapter/'adapter_model.safetensors')==ADAPTER_SHA
    rows=load_rows(a.suite); pos=[r for r in rows if not r['negative']]
    static=static_forensics(adapter/'adapter_model.safetensors'); (out/'C44_STATIC.json').write_text(json.dumps(static,indent=2,sort_keys=True))
    model,tok,abi,base_aux,adapt_aux=prepare(base,adapter); (out/'C44_RUNTIME_ABI.json').write_text(json.dumps(abi,indent=2,sort_keys=True))
    ctl=Controller(model,base_aux,adapt_aux); layers=int(model.base_model.model.config.num_hidden_layers)
    score_rows_set=[r for r in pos if r['split'] in {'DISCOVERY','CONFIRMATION','TACTICAL_OOD','QUIET_OOD'}][:160]
    scores={}; per={}
    for c in ['BASE','AUX_ONLY','LORA_ONLY','FULL']:
        ctl.set_condition(c); v=score_rows(model,tok,score_rows_set,a.batch); scores[c]=mean(v); per[c]=dict(zip([r['case_id'] for r in score_rows_set],v))
    locked=[r for r in pos if r['split'] in {'CONFIRMATION','TACTICAL_OOD','QUIET_OOD'}][:80]
    ctrls={}; ctrlper={}
    for c in ['RANDOM_SIGN','LAYER_SHUFFLE']:
        ctl.set_condition(c); v=score_rows(model,tok,locked,a.batch); ctrls[c]=mean(v); ctrlper[c]=dict(zip([r['case_id'] for r in locked],v))
    dose_rows=locked[:40]; doses={}
    for d in ['DOSE_0.25','DOSE_0.5','DOSE_1.5']:
        ctl.set_condition(d); doses[d]=mean(score_rows(model,tok,dose_rows,a.batch))
    gate=locked
