    c=Controller(m); c.set_condition('BASE'); assert all(abs(x.scaling[adapter_key(x)])<1e-12 for _,x in c.loras); c.set_condition('FULL'); c.random_sign(); c.restore_scale(); c.shuffle_B(); c.restore_B(); c.ablate_group('early:attn',3); c.group_only('late:mlp',3)
    print(json.dumps({'self_test':'PASS','lora_modules':len(c.loras)}))

def run(a):
    base=Path(a.work)/'base'; adapter=Path(a.work)/'adapter'; out=Path(a.out); out.mkdir(parents=True,exist_ok=True)
    assert sha(base/'model.safetensors')==BASE_SHA; assert sha(adapter/'adapter_model.safetensors')==ADAPTER_SHA
    rows=load_rows(a.suite); pos=[r for r in rows if not r['negative']]
    static=static_forensics(adapter/'adapter_model.safetensors'); (out/'C44_STATIC.json').write_text(json.dumps(static,indent=2,sort_keys=True))
    model,tok,abi=prepare(base,adapter); (out/'C44_RUNTIME_ABI.json').write_text(json.dumps(abi,indent=2,sort_keys=True))
    ctl=Controller(model); layers=int(model.base_model.model.config.num_hidden_layers)
    score_rows_set=[r for r in pos if r['split'] in {'DISCOVERY','CONFIRMATION','TACTICAL_OOD','QUIET_OOD'}][:192]
    scores={}; per={}
    for c in ['BASE','FULL']:
        ctl.set_condition(c); v=score_rows(model,tok,score_rows_set,a.batch); scores[c]=mean(v); per[c]=dict(zip([r['case_id'] for r in score_rows_set],v))
    locked=[r for r in pos if r['split'] in {'CONFIRMATION','TACTICAL_OOD','QUIET_OOD'}][:96]
    ctrls={}; ctrlper={}
    for c in ['RANDOM_SIGN','LAYER_SHUFFLE']:
        ctl.set_condition(c); v=score_rows(model,tok,locked,a.batch); ctrls[c]=mean(v); ctrlper[c]=dict(zip([r['case_id'] for r in locked],v))
    dose_rows=locked[:48]; doses={}
    for d in ['DOSE_0.25','DOSE_0.5','DOSE_1.5']:
        ctl.set_condition(d); doses[d]=mean(score_rows(model,tok,dose_rows,a.batch))
    gate=locked
    diffs=[per['FULL'][r['case_id']]-per['BASE'][r['case_id']] for r in gate]; delta=mean(diffs); ci=bootstrap_ci(diffs)
    fr=mean([per['FULL'][r['case_id']]-ctrlper['RANDOM_SIGN'][r['case_id']] for r in gate])
    fs=mean([per['FULL'][r['case_id']]-ctrlper['LAYER_SHUFFLE'][r['case_id']] for r in gate])
    sign=1 if delta>=0 else -1; control_sep=sign*fr>=0.05 and sign*fs>=0.05; ci_ex=(ci[0]>0 or ci[1]<0); teacher_gate=abs(delta)>=0.10 and ci_ex and control_sep
    # free generation on fixed 48 valid + 16 invalid
    gen_valid=locked[:48]; gen_neg=[r for r in rows if r['negative']][:16]; gen_rows=gen_valid+gen_neg; rb={r['case_id']:r for r in gen_rows}
    generation={}; genhash={}
    for c in ['BASE','FULL']:
        ctl.set_condition(c); items=generate_rows(model,tok,gen_rows,batch=1); met=evaluate_generation(items,rb,a.engine); genhash[c]=met; validmet=[x for x in met if not rb[x['case_id']]['negative']]; negmet=[x for x in met if rb[x['case_id']]['negative']]
        generation[c]=summarize_gen(validmet); generation[c]['invalid_fen_action_like_rate']=mean([x['action_like'] for x in negmet])
    legal_gain=generation['FULL']['legal_rate']-generation['BASE']['legal_rate']; top3_gain=generation['FULL']['top3_rate']-generation['BASE']['top3_rate']; invalid_delta=generation['FULL']['invalid_fen_action_like_rate']-generation['BASE']['invalid_fen_action_like_rate']
    positive=teacher_gate and delta>0 and (legal_gain>=0.10 or top3_gain>=0.05)
    base_cpl=generation['BASE']['mean_cp_loss_legal']; full_cpl=generation['FULL']['mean_cp_loss_legal']; cpl_worse=(base_cpl is not None and full_cpl is not None and full_cpl-base_cpl>=80)
    failure=teacher_gate and delta<0 and (legal_gain<=-0.10 or cpl_worse)
    effect=positive or failure
